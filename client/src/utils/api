/**
 * Save analysis result to database
 */
export async function saveAnalysisRecord({ image_name, image_path, analysis_result }) {
  const res = await fetch(`${API_BASE}/api/history`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ image_name, image_path, analysis_result })
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || '분석 기록 저장에 실패했습니다.');
  return data;
}

/**
 * Delete a history record by ID
 */
export async function deleteHistoryRecord(id) {
  const res = await fetch(`${API_BASE}/api/history/${id}`, {
    method: 'DELETE'
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || '기록 삭제에 실패했습니다.');
  return data;
}

/**
