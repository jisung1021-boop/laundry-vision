export async function clearAllHistoryRecords() {
  const res = await fetch(`${API_BASE}/api/history`, {
    method: 'DELETE'
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || '기록 초기화에 실패했습니다.');
