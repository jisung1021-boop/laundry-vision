const API_BASE = ''; // uses Vite proxy

/**
 * Check backend configuration and Gemini API connection status
 */
export async function fetchApiConfig() {
  const res = await fetch(`${API_BASE}/api/config`);
  if (!res.ok) throw new Error('API 설정을 불러오지 못했습니다.');
  return res.json();
}

/**
 * Update Gemini API Key dynamically
 */
export async function updateApiKey(apiKey) {
  const res = await fetch(`${API_BASE}/api/config/key`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ apiKey })
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || 'API 키 등록에 실패했습니다.');
  return data;
}

/**
 * Fetch care symbols guide data
 */
export async function fetchCareGuide(category = 'all', search = '') {
  const params = new URLSearchParams();
  if (category && category !== 'all') params.append('category', category);
  if (search) params.append('search', search);

  const res = await fetch(`${API_BASE}/api/guide?${params.toString()}`);
  if (!res.ok) throw new Error('세탁 기호 가이드를 불러오지 못했습니다.');
  return res.json();
}

/**
 * Fetch sample care labels
 */
export async function fetchSamples() {
  const res = await fetch(`${API_BASE}/api/guide/samples`);
  if (!res.ok) throw new Error('샘플 라벨을 불러오지 못했습니다.');
  return res.json();
}

/**
 * Analyze uploaded image file or sample
 */
export async function analyzeCareLabel({ file, sampleId }) {
  const formData = new FormData();
  if (file) {
    formData.append('image', file);
  }
  if (sampleId) {
    formData.append('sampleId', sampleId);
  }

  const res = await fetch(`${API_BASE}/api/analyze`, {
    method: 'POST',
    body: formData
  });

  const data = await res.json();
  if (!res.ok) {
    throw new Error(data.error || '이미지 분석에 실패했습니다.');
  }
  return data;
}

/**
 * Fetch history list
 */
export async function fetchHistory() {
  const res = await fetch(`${API_BASE}/api/history`);
  if (!res.ok) throw new Error('분석 기록을 불러오지 못했습니다.');
