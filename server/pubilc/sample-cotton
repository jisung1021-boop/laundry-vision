<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 800" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#F5F6F8"/>
    </linearGradient>
    <filter id="shadow" x="-5%" y="-3%" width="110%" height="110%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-opacity="0.12"/>
    </filter>
  </defs>

  <!-- Tag Body -->
  <rect x="50" y="30" width="500" height="740" rx="16" fill="url(#bg)" stroke="#E2E8F0" stroke-width="2" filter="url(#shadow)"/>
  
  <!-- Stitching Line -->
  <line x1="70" y1="50" x2="530" y2="50" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="6,4"/>

  <!-- Brand / Item Header -->
  <text x="300" y="110" font-family="'Pretendard', sans-serif" font-size="26" font-weight="800" fill="#1E293B" text-anchor="middle" letter-spacing="4">ESSENTIALS</text>
  <text x="300" y="140" font-family="'Pretendard', sans-serif" font-size="14" font-weight="500" fill="#64748B" text-anchor="middle">100% PREMIUM COTTON TEE</text>
  
  <line x1="90" y1="170" x2="510" y2="170" stroke="#E2E8F0" stroke-width="1.5"/>

  <!-- Fabric Composition -->
  <text x="90" y="210" font-family="'Pretendard', sans-serif" font-size="15" font-weight="700" fill="#334155">[품질표시]</text>
  <text x="90" y="235" font-family="'Pretendard', sans-serif" font-size="14" fill="#475569">겉감: 면 100% (COTTON)</text>
  <text x="90" y="260" font-family="'Pretendard', sans-serif" font-size="13" fill="#64748B">호칭: 100 (L) / 제조국: 대한민국</text>

  <line x1="90" y1="285" x2="510" y2="285" stroke="#E2E8F0" stroke-width="1.5"/>

  <!-- Care Symbols Section Header -->
  <text x="300" y="325" font-family="'Pretendard', sans-serif" font-size="16" font-weight="800" fill="#0F172A" text-anchor="middle">취급상 주의사항 (CARE LABELS)</text>

  <!-- 5 Standard Symbols Row -->
  <!-- 1. Wash: Tub with 40°C -->
  <g transform="translate(75, 360)">
    <rect width="70" height="70" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
    <!-- Tub -->
    <path d="M15 30 L20 52 C20 54 22 56 25 56 L45 56 C48 56 50 54 50 52 L55 30 Z" fill="none" stroke="#1E293B" stroke-width="2.5" stroke-linejoin="round"/>
    <!-- Water wave -->
    <path d="M15 32 Q25 28 35 32 T55 32" fill="none" stroke="#0284C7" stroke-width="2"/>
    <!-- 40°C text -->
    <text x="35" y="47" font-family="sans-serif" font-size="12" font-weight="700" fill="#1E293B" text-anchor="middle">40°</text>
    <text x="35" y="86" font-family="sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">물세탁 40°</text>
  </g>

  <!-- 2. Bleach: Triangle with two diagonal lines (Oxygen bleach only) -->
  <g transform="translate(165, 360)">
    <rect width="70" height="70" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
    <polygon points="35,18 15,54 55,54" fill="none" stroke="#1E293B" stroke-width="2.5" stroke-linejoin="round"/>
    <line x1="28" y1="52" x2="38" y2="34" stroke="#1E293B" stroke-width="2"/>
    <line x1="36" y1="52" x2="46" y2="34" stroke="#1E293B" stroke-width="2"/>
    <text x="35" y="86" font-family="sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">산소계표백</text>
  </g>

  <!-- 3. Dry: Square with circle and 1 dot (Low tumble dry) -->
  <g transform="translate(255, 360)">
    <rect width="70" height="70" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
    <rect x="18" y="18" width="34" height="34" rx="3" fill="none" stroke="#1E293B" stroke-width="2.5"/>
    <circle cx="35" cy="35" r="13" fill="none" stroke="#1E293B" stroke-width="2"/>
    <circle cx="35" cy="35" r="2.5" fill="#1E293B"/>
    <text x="35" y="86" font-family="sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">저온건조</text>
  </g>

  <!-- 4. Iron: Iron with 2 dots (Medium iron 150°C) -->
  <g transform="translate(345, 360)">
    <rect width="70" height="70" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
    <path d="M18 48 L52 48 C52 48 50 36 42 36 L28 36 C22 36 18 42 18 48 Z M28 36 L28 28 L40 28" fill="none" stroke="#1E293B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="31" cy="42" r="2" fill="#1E293B"/>
    <circle cx="39" cy="42" r="2" fill="#1E293B"/>
    <text x="35" y="86" font-family="sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">중온다림질</text>
  </g>

  <!-- 5. Dryclean: Circle (Dryclean safe) -->
  <g transform="translate(435, 360)">
    <rect width="70" height="70" rx="8" fill="#F1F5F9" stroke="#94A3B8" stroke-width="1.5"/>
    <circle cx="35" cy="36" r="16" fill="none" stroke="#1E293B" stroke-width="2.5"/>
    <text x="35" y="86" font-family="sans-serif" font-size="11" font-weight="600" fill="#475569" text-anchor="middle">드라이가능</text>
  </g>

  <line x1="90" y1="480" x2="510" y2="480" stroke="#E2E8F0" stroke-width="1.5"/>

  <!-- Text instructions in Korean -->
  <g transform="translate(90, 510)">
    <text x="0" y="0" font-family="'Pretendard', sans-serif" font-size="13" font-weight="700" fill="#1E293B">• 세탁 시 세탁망 사용을 권장합니다.</text>
    <text x="0" y="25" font-family="'Pretendard', sans-serif" font-size="13" fill="#475569">• 염소계 표백제 사용을 절대 금합니다.</text>
    <text x="0" y="50" font-family="'Pretendard', sans-serif" font-size="13" fill="#475569">• 짙은 색상은 이염될 수 있으니 단독 세탁하세요.</text>
    <text x="0" y="75" font-family="'Pretendard', sans-serif" font-size="13" fill="#475569">• 회전식 건조기 사용 시 수축될 수 있습니다.</text>
    <text x="0" y="100" font-family="'Pretendard', sans-serif" font-size="13" fill="#475569">• 나염 부위에는 직접 다림질을 피하십시오.</text>
  </g>

  <!-- Barcode & Brand Footer -->
  <g transform="translate(190, 660)">
    <rect x="0" y="0" width="220" height="40" fill="#1E293B" opacity="0.05"/>
    <line x1="15" y1="5" x2="15" y2="35" stroke="#1E293B" stroke-width="2"/>
    <line x1="22" y1="5" x2="22" y2="35" stroke="#1E293B" stroke-width="4"/>
    <line x1="32" y1="5" x2="32" y2="35" stroke="#1E293B" stroke-width="1.5"/>
    <line x1="40" y1="5" x2="40" y2="35" stroke="#1E293B" stroke-width="3"/>
    <line x1="52" y1="5" x2="52" y2="35" stroke="#1E293B" stroke-width="2"/>
    <line x1="62" y1="5" x2="62" y2="35" stroke="#1E293B" stroke-width="5"/>
    <line x1="75" y1="5" x2="75" y2="35" stroke="#1E293B" stroke-width="1.5"/>
    <line x1="85" y1="5" x2="85" y2="35" stroke="#1E293B" stroke-width="3.5"/>
    <line x1="98" y1="5" x2="98" y2="35" stroke="#1E293B" stroke-width="2"/>
    <line x1="110" y1="5" x2="110" y2="35" stroke="#1E293B" stroke-width="4"/>
    <line x1="125" y1="5" x2="125" y2="35" stroke="#1E293B" stroke-width="1.5"/>
    <line x1="135" y1="5" x2="135" y2="35" stroke="#1E293B" stroke-width="3"/>
    <line x1="148" y1="5" x2="148" y2="35" stroke="#1E293B" stroke-width="5"/>
    <line x1="165" y1="5" x2="165" y2="35" stroke="#1E293B" stroke-width="2"/>
    <line x1="175" y1="5" x2="175" y2="35" stroke="#1E293B" stroke-width="3"/>
    <line x1="190" y1="5" x2="190" y2="35" stroke="#1E293B" stroke-width="4"/>
    <line x1="205" y1="5" x2="205" y2="35" stroke="#1E293B" stroke-width="2"/>
    <text x="110" y="52" font-family="monospace" font-size="11" fill="#64748B" text-anchor="middle" letter-spacing="3">8809123456789</text>
  </g>
</svg>
